{
  "name": "@number-guess/indexer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:cleanup && apibara dev",
    "build": "apibara build",
    "start": "npm run db:migrate && npm run db:cleanup && apibara start",
    "db:cleanup": "node scripts/cleanup-triggers.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": ["starknet", "number-guess", "indexer", "apibara"],
  "license": "MIT",
  "description": "Number Guess game event indexer using Apibara with PostgreSQL persistence",
  "dependencies": {
    "apibara": "next",
    "@apibara/indexer": "next",
    "@apibara/starknet": "next",
    "@apibara/plugin-drizzle": "next",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "pg": "^8.13.0",
    "starknet": "^9.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
